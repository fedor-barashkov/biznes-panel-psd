<Window x:Class="ITD.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Исполнительная документация" Height="760" Width="1240"
        MinHeight="620" MinWidth="980" WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#173A55" Padding="18,12">
      <DockPanel>
        <TextBlock Text="ИТД" Foreground="White" FontSize="22" FontWeight="Bold" />
        <TextBlock Text="  Исполнительная документация" Foreground="#D7E5EF"
                   FontSize="15" VerticalAlignment="Center" />
      </DockPanel>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="240" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#F0F3F6" Padding="12">
        <StackPanel>
          <TextBlock Text="РАБОЧИЕ РАЗДЕЛЫ" FontSize="11" FontWeight="Bold"
                     Foreground="#657786" Margin="8,8,8,14" />
          <Button Content="Объекты" HorizontalContentAlignment="Left" Background="#DCE8F1"
                  Click="Objects_Click" />
          <Button Content="База" HorizontalContentAlignment="Left" Click="Base_Click" />
          <Separator Margin="4,16" />
          <TextBlock Text="Основной контур приложения — подготовка, оформление, ведение и передача ИД."
                     TextWrapping="Wrap" Foreground="#52616D" Margin="8" />
        </StackPanel>
      </Border>
      <Grid Grid.Column="1" Margin="22">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Объекты строительства" FontSize="25" FontWeight="SemiBold" />
            <TextBlock Text="Создание и ведение объектов и подобъектов" Foreground="#687985" />
          </StackPanel>
          <Button DockPanel.Dock="Right" Content="＋ Новый объект" Click="AddObject_Click"
                  Background="#245B86" Foreground="White" />
        </DockPanel>
        <Border Grid.Row="1" BorderBrush="#D9E0E6" BorderThickness="1" CornerRadius="5"
                Padding="12" Margin="0,0,0,12">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="NameBox" Grid.Column="0" ToolTip="Наименование объекта"
                     Text=""/>
            <TextBox x:Name="AddressBox" Grid.Column="1" ToolTip="Адрес объекта"/>
            <TextBox x:Name="CustomerBox" Grid.Column="2" ToolTip="Заказчик"/>
            <Button Grid.Column="3" Content="Сохранить" Click="SaveObject_Click"/>
          </Grid>
        </Border>
        <DataGrid x:Name="ObjectsGrid" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionChanged="ObjectsGrid_SelectionChanged">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Наименование объекта" Binding="{Binding Name}" Width="2*" />
            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="2*" />
            <DataGridTextColumn Header="Заказчик" Binding="{Binding CustomerName}" Width="*" />
            <DataGridTextColumn Header="Создан" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy}}" Width="110" />
          </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0"
                   Foreground="#63727D" Text="Локальная база данных готова." />
      </Grid>
    </Grid>
  </DockPanel>
</Window>
