{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.construction-ai.local/roles/gip-review/0.1",
  "title": "Construction GIP Review and Bill of Quantities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "source_set",
    "review_status",
    "boq_items",
    "issues",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "object_id": {
      "type": "string",
      "minLength": 1
    },
    "subobject_id": {
      "type": "string"
    },
    "source_set": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "review_status": {
      "enum": [
        "draft",
        "in_review",
        "needs_input",
        "approved",
        "rejected"
      ]
    },
    "boq_items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/boqItem"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "question",
          "blocking"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "blocking": {
            "type": "boolean"
          },
          "related_item_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "gip_approval": {
      "$ref": "#/$defs/approval"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "review_status": {
            "const": "approved"
          }
        },
        "required": [
          "review_status"
        ]
      },
      "then": {
        "required": [
          "gip_approval"
        ],
        "properties": {
          "gip_approval": {
            "properties": {
              "decision": {
                "const": "approved"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "sheet": {
          "type": "string"
        },
        "cell": {
          "type": "string"
        },
        "drawing_number": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "axis_or_level": {
          "type": "string"
        },
        "element_id": {
          "type": "string"
        }
      },
      "minProperties": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "document_type",
        "document_code",
        "revision",
        "source_status"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "enum": [
            "project_documentation",
            "working_documentation",
            "specification",
            "survey",
            "technical_conditions",
            "permit",
            "expert_review",
            "rfi_response",
            "other"
          ]
        },
        "document_code": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "source_status": {
          "enum": [
            "current",
            "superseded",
            "draft",
            "unknown"
          ]
        },
        "document_date": {
          "type": "string",
          "format": "date"
        },
        "locator": {
          "$ref": "#/$defs/locator"
        }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "locator"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "boqItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "work_code",
        "work_name",
        "unit",
        "quantity_basis",
        "source_refs",
        "review_state"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "work_code": {
          "type": "string"
        },
        "work_name": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "number",
          "minimum": 0
        },
        "quantity_basis": {
          "enum": [
            "extracted",
            "calculated",
            "interpreted",
            "unresolved"
          ]
        },
        "calculation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "expression"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "expression": {
              "type": "string",
              "minLength": 1
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "review_state": {
          "enum": [
            "unreviewed",
            "checked",
            "conflict",
            "needs_input"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "quantity_basis": {
                "const": "calculated"
              }
            },
            "required": [
              "quantity_basis"
            ]
          },
          "then": {
            "required": [
              "quantity",
              "calculation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "quantity_basis": {
                "const": "unresolved"
              }
            },
            "required": [
              "quantity_basis"
            ]
          },
          "then": {
            "not": {
              "required": [
                "quantity"
              ]
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id",
        "severity",
        "description",
        "source_refs",
        "status"
      ],
      "properties": {
        "issue_id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "critical",
            "major",
            "minor",
            "info"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "status": {
          "enum": [
            "open",
            "resolved",
            "accepted_risk"
          ]
        },
        "resolution_note": {
          "type": "string"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "approver_id",
        "decided_at"
      ],
      "properties": {
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "returned_for_revision"
          ]
        },
        "approver_id": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "comment": {
          "type": "string"
        }
      }
    }
  }
}
