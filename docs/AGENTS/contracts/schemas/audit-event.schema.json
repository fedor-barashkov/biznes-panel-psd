{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.construction-ai.local/security/audit-event/0.1",
  "title": "Append-only security and action audit event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "occurred_at",
    "request_id",
    "actor",
    "action",
    "resource",
    "outcome",
    "policy_version",
    "event_hash"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "correlation_id": {
      "type": "string"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_id",
        "actor_type"
      ],
      "properties": {
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_type": {
          "enum": [
            "human",
            "agent",
            "service"
          ]
        },
        "role": {
          "type": "string"
        }
      }
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_type",
        "resource_id"
      ],
      "properties": {
        "resource_type": {
          "type": "string"
        },
        "resource_id": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ]
        },
        "object_id": {
          "type": "string"
        }
      }
    },
    "outcome": {
      "enum": [
        "allowed",
        "denied",
        "committed",
        "failed",
        "expired",
        "replay_rejected",
        "version_conflict"
      ]
    },
    "decision_id": {
      "type": "string"
    },
    "approval_record_id": {
      "type": "string"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "adapter_id": {
      "type": "string"
    },
    "adapter_version": {
      "type": "string"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "output_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "reason_code": {
      "type": "string"
    },
    "previous_event_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "event_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
