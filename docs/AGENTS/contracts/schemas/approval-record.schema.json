{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.construction-ai.local/contracts/approval-record/0.1",
  "title": "Construction AI Human Approval Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id",
    "request_id",
    "action_id",
    "target",
    "decision",
    "decided_by",
    "actor_type",
    "decided_at",
    "policy_version"
  ],
  "properties": {
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "action_id": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "approved",
        "rejected",
        "returned_for_revision",
        "expired",
        "revoked"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string",
      "minLength": 1
    },
    "comment": {
      "type": "string"
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "actor_type": {
      "const": "human"
    }
  }
}
