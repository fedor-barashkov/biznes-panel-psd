{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.construction-ai.local/roles/estimator-exchange/0.1",
  "title": "Construction Estimator and Grand-Smeta Exchange",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exchange_id",
    "direction",
    "source_boq",
    "normative_basis",
    "grand_smeta",
    "items",
    "mapping_changes",
    "exchange_status"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "exchange_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "to_grand_smeta",
        "from_grand_smeta",
        "round_trip"
      ]
    },
    "source_boq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "revision",
        "approval_status"
      ],
      "properties": {
        "artifact_id": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        },
        "approval_status": {
          "enum": [
            "approved",
            "draft",
            "rejected"
          ]
        }
      }
    },
    "normative_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methodology",
        "edition",
        "database_id"
      ],
      "properties": {
        "methodology": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "database_id": {
          "type": "string",
          "minLength": 1
        },
        "region": {
          "type": "string"
        },
        "price_level_date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "grand_smeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product",
        "version",
        "exchange_format"
      ],
      "properties": {
        "product": {
          "const": "ГРАНД-Смета"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "exchange_format": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "estimate_item_id",
          "source_boq_item_id",
          "norm_code",
          "norm_name",
          "unit",
          "quantity",
          "preservation_status"
        ],
        "properties": {
          "estimate_item_id": {
            "type": "string"
          },
          "source_boq_item_id": {
            "type": "string"
          },
          "norm_code": {
            "type": "string",
            "minLength": 1
          },
          "norm_name": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "coefficients": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "value"
              ],
              "properties": {
                "code": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                },
                "justification": {
                  "type": "string"
                }
              }
            }
          },
          "resource_lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resource_code",
                "resource_name",
                "unit",
                "quantity"
              ],
              "properties": {
                "resource_code": {
                  "type": "string"
                },
                "resource_name": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                }
              }
            }
          },
          "preservation_status": {
            "enum": [
              "exact",
              "transformed_with_log",
              "loss_detected",
              "not_compared"
            ]
          },
          "original_values": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "mapping_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "source_value",
          "target_value",
          "reason"
        ],
        "properties": {
          "field": {
            "type": "string"
          },
          "source_value": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "target_value": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exchange_status": {
      "enum": [
        "draft",
        "ready_for_review",
        "validated",
        "failed"
      ]
    },
    "draft_only": {
      "type": "boolean",
      "default": false
    },
    "round_trip_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "result"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "result": {
          "enum": [
            "identical",
            "differences_reported",
            "failed",
            "not_available"
          ]
        },
        "report_artifact_id": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_boq": {
            "properties": {
              "approval_status": {
                "enum": [
                  "draft",
                  "rejected"
                ]
              }
            },
            "required": [
              "approval_status"
            ]
          }
        },
        "required": [
          "source_boq"
        ]
      },
      "then": {
        "properties": {
          "draft_only": {
            "const": true
          },
          "exchange_status": {
            "enum": [
              "draft",
              "failed"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "exchange_status": {
            "const": "validated"
          }
        },
        "required": [
          "exchange_status"
        ]
      },
      "then": {
        "required": [
          "round_trip_comparison"
        ],
        "properties": {
          "round_trip_comparison": {
            "properties": {
              "performed": {
                "const": true
              },
              "result": {
                "enum": [
                  "identical",
                  "differences_reported"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
