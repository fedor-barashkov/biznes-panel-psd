{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.construction-ai.local/trusted-context/gip-approval/0.1",
  "title": "Trusted GIP approval context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_record"
  ],
  "properties": {
    "approval_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "artifact_id",
        "revision",
        "decision",
        "actor_id",
        "actor_role",
        "authorized"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "minLength": 1
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": [
            "string",
            "integer"
          ]
        },
        "decision": {
          "const": "approved"
        },
        "actor_id": {
          "type": "string",
          "minLength": 1
        },
        "actor_role": {
          "const": "GIP"
        },
        "authorized": {
          "const": true
        }
      }
    }
  }
}
